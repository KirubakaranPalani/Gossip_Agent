{
  "name": "gossip-agent",
  "version": "1.0.0",
  "description": "A mobile-first news reader with India and World editions.",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "mobile:sync": "npm run build && cap sync android",
    "android:run": "npm run mobile:sync && cap run android",
    "android:apk": "npm run mobile:sync && cd android && ./gradlew assembleDebug"
  },
  "keywords": [
    "news",
    "reader",
    "gossip-agent"
  ],
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@cloudflare/vite-plugin": "^1.70.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.166.0"
  },
  "type": "module"
}
